# Copy to `.env` and fill in. Never commit `.env`.

# Hex private key of the account that pays gas (0x-prefixed or plain hex).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC URL for the target chain (examples).
# RPC_URL=https://eth.llamarpc.com
# RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Token metadata
TOKEN_NAME=Open Template Token
TOKEN_SYMBOL=OTT

# Address that receives Ownable permissions (can be a multisig; may differ from deployer).
INITIAL_OWNER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
